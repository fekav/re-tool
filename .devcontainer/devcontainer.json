{
  "name": "quarkus-ollama-neo4j",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",

  "runServices": [
    "ollama",
    "neo4j"
  ],

  "forwardPorts": [
    8080,
    5005,
    11434,
    7474,
    7687
  ],

  "portsAttributes": {
    "8080": {
      "label": "Quarkus HTTP",
      "onAutoForward": "notify"
    },
    "5005": {
      "label": "Quarkus Debug"
    },
    "11434": {
      "label": "Ollama API"
    },
    "7474": {
      "label": "Neo4j Browser"
    },
    "7687": {
      "label": "Neo4j Bolt"
    }
  },
	"otherPortsAttributes": {
    	"onAutoForward": "ignore"
	},

  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "redhat.vscode-quarkus"
      ],
      "settings": {
        "java.import.gradle.enabled": true,
        "java.configuration.updateBuildConfiguration": "automatic",
        "java.compile.nullAnalysis.mode": "automatic",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "postCreateCommand": "java -version && bwrap --version && git --version && rg --version && node --version && npm --version"
}