{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fekav.io/ai/v1/requirement-syntax.schema.json",
  "type": "object",
  "required": ["requirementElements"],
  "additionalProperties": false,
  "properties": {
    "requirementElements": {
      "type": "object",
      "required": ["SUBJECT", "ACTION", "OBJECT"],
      "additionalProperties": false,
      "properties": {
        "SUBJECT": {
          "type": "string"
        },
        "ACTION": {
          "type": "string"
        },
        "OBJECT": {
          "type": "string"
        },
        "CONSTRAINT": {
          "type": "string"
        },
        "CONDITION": {
          "type": "string"
        }
      }
    }
  }
}
